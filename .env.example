# Core application
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ZERO-COST MODE IS THE DEFAULT. Use OpenRouter free-only router or an explicitly free :free model.
# Free variants are $0 but rate-limited. Never add credits or enable paid routing.
YTAGENT_ZERO_COST_MODE=true
OPENROUTER_API_KEY=
OPENROUTER_SCRIPT_MODEL=openrouter/free
# Optional independent $0 story-director fallbacks. Configure only free-tier accounts.
GROQ_API_KEY=
GROQ_SCRIPT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_FREE_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-2.5-flash
# Set true only when the Google project has billing disabled and is using AI Studio Free Tier.
GEMINI_FREE_TIER_ONLY=false
# Do not add trial-credit or paid API keys here.

# Hosted video APIs are blocked in zero-cost mode. Do not configure paid providers.
# BytePlus Seedance is a paid ModelArk API, not a verified free endpoint.
# Keep all three switches below disabled in the $0 setup. The code blocks requests
# unless zero-cost mode is disabled AND paid usage is explicitly approved.
ARK_SEEDANCE_ENABLED=false
ARK_ALLOW_PAID_VIDEO_APIS=false
ARK_API_KEY=
ARK_VIDEO_MODEL=dreamina-seedance-2-5-260628
AGNES_API_KEY=
AGNES_FREE_QUOTA_CONFIRMED=false
AGNES_VIDEO_MODEL=

# Optional Agnes v2.0 adapter based on uglylee/free-video-generator.
# Same Agnes infrastructure as the primary provider. Disabled by default.
AGNES_V2_FALLBACK_ENABLED=false
AGNES_V2_FREE_QUOTA_CONFIRMED=false
AGNES_V2_VIDEO_MODEL=agnes-video-v2.0

# Optional YumCut User API full-video fallback. Disabled by default.
# Only set commercial approval after obtaining the required permission/licence.
# The adapter quotes token cost and refuses to create a project above this cap.
YUMCUT_API_KEY=
YUMCUT_FALLBACK_ENABLED=false
YUMCUT_COMMERCIAL_USE_APPROVED=false
YUMCUT_MAX_TOKENS_PER_VIDEO=0

# Optional QingCloud Compute connection. Keep the admin token on the YTAgent server only.
# Use the HTTPS URL of the deployed QingCloud coordinator.
QINGCLOUD_URL=
QINGCLOUD_ADMIN_TOKEN=

# Optional durable queue and session store
REDIS_URL=

# Optional Kaggle notebook automation credentials
KAGGLE_API_TOKEN=
KAGGLE_NOTEBOOK_REF=samsonbamigboye/notebook477419e21e

# Required for the outbound-polling Kaggle Wan worker.
# Set the same private value in Railway and Kaggle Notebook Secrets.
YT_AGENT_WORKER_TOKEN=

# Optional durable media storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
