# Core application
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ZERO-COST MODE IS THE DEFAULT. Only OpenRouter models explicitly ending in :free are allowed.
# Free variants are $0 but rate-limited. Never add credits or enable paid routing.
YTAGENT_ZERO_COST_MODE=true
OPENROUTER_API_KEY=
OPENROUTER_SCRIPT_MODEL=openai/gpt-oss-20b:free
# Legacy provider keys are ignored while YTAGENT_ZERO_COST_MODE=true.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=

# Hosted video APIs are blocked in zero-cost mode. Do not configure paid providers.
AGNES_API_KEY=
AGNES_FREE_QUOTA_CONFIRMED=false
AGNES_VIDEO_MODEL=

# Optional durable queue and session store
REDIS_URL=

# Optional Kaggle notebook automation credentials
KAGGLE_API_TOKEN=
KAGGLE_NOTEBOOK_REF=samsonbamigboye/notebook477419e21e

# Required for the outbound-polling Kaggle Wan worker.
# Set the same private value in Railway and Kaggle Notebook Secrets.
YT_AGENT_WORKER_TOKEN=

# Optional durable media storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
