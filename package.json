{
  "name": "ytagent",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-friendly YouTube publishing assistant with narrated video generation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test video-compiler/*.test.js video-providers/*.test.js middleware/*.test.js kaggle-mcp.test.js gpu-worker-bridge.test.js kaggle-notebook.test.js studio-project.test.js kaggle-worker-session.test.js object-storage.test.js",
    "build": "vite build --config studio/vite.config.mjs",
    "dev:studio": "vite --config studio/vite.config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "googleapis": "^144.0.0",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "bullmq": "^5.34.3",
    "ioredis": "^5.4.2",
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.33.5",
    "node-edge-tts": "^1.2.12",
    "@clipkit/editor": "1.1.0",
    "@clipkit/runtime": "1.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@aws-sdk/client-s3": "^3.850.0",
    "connect-redis": "8.0.2"
  },
  "devDependencies": {
    "vite": "^6.4.6",
    "@tailwindcss/vite": "^4.3.5"
  }
}
