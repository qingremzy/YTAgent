# Core application
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-secret

# Google / YouTube OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# AI story director (at least one provider key is required)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional paid video provider. Leave disabled unless you have confirmed
# the provider's current pricing and available quota in your own account.
AGNES_API_KEY=
AGNES_FREE_QUOTA_CONFIRMED=false
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# Optional durable queue and session store
REDIS_URL=

# Optional Kaggle notebook automation credentials
KAGGLE_API_TOKEN=
KAGGLE_NOTEBOOK_REF=samsonbamigboye/notebook477419e21e

# Required for the outbound-polling Kaggle Wan worker.
# Set the same private value in Railway and Kaggle Notebook Secrets.
YT_AGENT_WORKER_TOKEN=

# Optional durable media storage (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
